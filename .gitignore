*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
backend/*.log
!logs/.gitkeep

# --------------------------------------------
# 🔒 SECRETS & KEYS
# --------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/
credentials.json
service-account*.json
!credentials.example.json

# --------------------------------------------
# 📊 TESTING & COVERAGE
# --------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/

# --------------------------------------------
# 📦 DEPENDENCY CACHES
# --------------------------------------------
.pip/
pip-log.txt
pip-delete-this-directory.txt
.node_repl_history
.yarn-integrity

# --------------------------------------------
# 🚀 DEPLOYMENT / DOCKER
# --------------------------------------------
.dockerignore
docker-compose.override.yml
.docker/
kubernetes/
k8s/
*.bak
*.backup
*.old

# --------------------------------------------
# 📁 TEMPORARY FILES
# --------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
backend/tmp/
backend/temp/

# --------------------------------------------
# 📊 DATABASE MIGRATIONS (Alembic)
# --------------------------------------------
# Keep migration scripts, ignore compiled
alembic/versions/__pycache__/

# --------------------------------------------
# 🎯 PROJECT SPECIFIC
# --------------------------------------------
# Generated reports
backend/reports/
backend/generated/
reports/
*.pdf
*.csv
!docs/**/*.csv
!docs/**/*.pdf

# Uploaded files
backend/uploads/
backend/media/
media/
uploads/

# Backup files
*.bak
*.orig

# --------------------------------------------
# 🔧 GITHUB SPECIFIC
# --------------------------------------------
.github/workflows/*.yml.example
# ============================================
# AI Decision Audit Agent - .gitignore
# ============================================

# --------------------------------------------
# 🔐 ENVIRONMENT FILES (CRITICAL - NEVER PUSH)
# --------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
backend/.env
frontend/.env
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# --------------------------------------------
# 🐍 PYTHON
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
ENV/
env/
.venv/
backend/venv/
backend/env/
backend/.venv/

# Python Testing
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Python Type Checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Python Linting
.ruff_cache/
.flake8

# --------------------------------------------
# 🗄️ DATABASES (LOCAL ONLY)
# --------------------------------------------
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
backend/data/*.sqlite3
backend/data/*.db

# Keep database folder structure
!backend/data/.gitkeep
!database/backups/.gitkeep

# --------------------------------------------
# 📦 NODE / REACT / FRONTEND
# --------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/
.pnp
.pnp.js

# Frontend builds
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
dist-ssr/
*.local

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --------------------------------------------
# 🔨 BUILD OUTPUTS
# --------------------------------------------
build/
dist/
out/
target/
*.exe
*.dll
*.so
*.dylib
*.class

# --------------------------------------------
# 🎨 IDE / EDITOR
# --------------------------------------------
