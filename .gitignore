.pip/
pip-log.txt
pip-delete-this-directory.txt
.node_repl_history
.yarn-integrity

# --------------------------------------------
# 🚀 DEPLOYMENT / DOCKER
# --------------------------------------------
.dockerignore
docker-compose.override.yml
.docker/
kubernetes/
k8s/
*.bak
*.backup
*.old

# --------------------------------------------
# 📁 TEMPORARY FILES
# --------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
backend/tmp/
backend/temp/

# --------------------------------------------
# 📊 DATABASE MIGRATIONS (Alembic)
