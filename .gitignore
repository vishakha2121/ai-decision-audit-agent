# ============================================
# AI Decision Audit Agent - .gitignore
# ============================================

# --------------------------------------------
# 🔐 ENVIRONMENT FILES (CRITICAL - NEVER PUSH)
# --------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
backend/.env
frontend/.env
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# --------------------------------------------
# 🐍 PYTHON
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
ENV/
env/
.venv/
backend/venv/
backend/env/
backend/.venv/

# Python Testing
