*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
backend/data/*.sqlite3
backend/data/*.db

# Keep database folder structure
!backend/data/.gitkeep
!database/backups/.gitkeep

# --------------------------------------------
# 📦 NODE / REACT / FRONTEND
# --------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/
.pnp
.pnp.js

# Frontend builds
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
dist-ssr/
*.local

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

