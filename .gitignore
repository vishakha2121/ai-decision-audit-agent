# 📊 TESTING & COVERAGE
# --------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/

# --------------------------------------------
# 📦 DEPENDENCY CACHES
# --------------------------------------------
.pip/
pip-log.txt
pip-delete-this-directory.txt
.node_repl_history
.yarn-integrity

